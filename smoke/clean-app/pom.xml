<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>clean-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>clean-app</name>
    <description>A Boot app with the starter and nothing else, to prove no configuration is needed.</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- What every new Boot app has. log-guard imposes no logging backend of its own. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- No default on purpose: a pinned version here would go stale at the first release and
             quietly check an artifact nobody ships. smoke/verify.sh reads the reactor version and
             passes it in; to build this app by hand, do the same:
             mvn package -Dlog-guard.version=0.1.0-SNAPSHOT -->
        <dependency>
            <groupId>io.github.dancan254</groupId>
            <artifactId>log-guard-spring-boot-starter</artifactId>
            <version>${log-guard.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
